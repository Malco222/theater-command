{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["three"],
    "paths": { "@tc/*": ["./src/*"], "@gates/*": ["/mnt/project-files/gates/*"] }
  },
  "include": ["src", "tests", "data"]
}
