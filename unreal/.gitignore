# Unreal Engine build products and caches. Never commit these: they are large,
# machine-specific, and Unreal rebuilds them on its own.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
.vs/
.vscode/
.idea/
*.xcworkspace
*.xcodeproj
*.sln
.DS_Store

# Build tools fetched for this machine (Node.js), not part of the game.
.tools/

# The music is made by Tools/build_music.sh and is too large to keep here.
TheaterCommand/Content/Campaign/Music/
