+AAirBattle::FAirTake AAirBattle::AskTake(const FTakeAsk& Ask)
+{
+	FAirTake Take;
+	if (!BeginTake(Ask, Take) && Take.bHeld)
+	{
+		// (no room this frame: held for a following frame, where the held are begun before the new; TakesDue)
+		HeldTakes.Add(Ask);
+		++TakesHeld;
+	}
+	return Take;
+}
+
+bool AAirBattle::BeginTake(const FTakeAsk& Ask, FAirTake& Out)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(AirBattle_BeginTake);
+	Out = FAirTake();
+	USoundBase* const Played = Ask.Played.Get();
+	USoundAttenuation* const Family = Ask.Family.Get();
+	if (!Played)
+	{
+		return false;
+	}
+	// (past its family's silent distance from the eye: not laid at all, as Lay has it, so neither held nor counted)
+	if (Ask.bPlaced && Family && Eye)
+	{
+		const double Reach = Family->Attenuation.AttenuationShapeExtents.X + Family->Attenuation.FalloffDistance;
+		if (FVector::DistSquared(Ask.Where, Eye->GetActorLocation()) > Reach * Reach)
+		{
+			return false;
+		}
+	}
+	// The cap: past TakesPerFrame takes begun this frame (near ones counted too), a far take waits for a following frame.
+	if (!Ask.bNear && TakesPerFrame > 0 && TakesBegun >= TakesPerFrame)
+	{
+		Out.bHeld = true;
+		return false;
+	}
+	if (PoolVoices > 0)
+	{
+		// The pool: a voice whose last take has ended (IsPlaying false: played out, or its fade done), or one more made
+		// while there are fewer than PoolMost. A voice fading out is not given another take until its fade is done.
+		int32 Slot = INDEX_NONE;
+		int32 Sounding = 0;
+		for (int32 K = 0; K < VoicePool.Num(); ++K)
+		{
+			UAudioComponent* const Voice = VoicePool[K];
+			if (Voice && Voice->IsPlaying())
+			{
+				Sounding += VoiceTakes[K].bFading ? 0 : 1;
+			}
+			else if (Voice && Slot == INDEX_NONE)
+			{
+				Slot = K;
+			}
+		}
+		const bool bRoom = Slot != INDEX_NONE || VoicePool.Num() < PoolMost;
+		if (!bRoom && !Ask.bNear)
+		{
+			Out.bHeld = true;
+			return false;
+		}
+		if (bRoom && Sounding >= PoolVoices)
+		{
+			// (as many sounding as the pool allows: the farthest far take, 300 m or more from the eye where it is now, gives
+			// its voice up, faded over air.limits.cutFade; to a far take only one farther off than it. None: a near take is
+			// laid over the count, a far one waits)
+			const FVector Listener = Eye ? Eye->GetActorLocation() : FVector::ZeroVector;
+			const double Close = 300.0 * UnitsPerMetre;
+			const double Beyond = Ask.bNear ? Close : FVector::Dist(Ask.Where, Listener);
+			double Farthest = -1.0;
+			int32 Taken = INDEX_NONE;
+			for (int32 K = 0; K < VoicePool.Num(); ++K)
+			{
+				UAudioComponent* const Voice = VoicePool[K];
+				if (Voice && VoiceTakes[K].bFar && !VoiceTakes[K].bFading && Voice->IsPlaying())
+				{
+					const double Off = FVector::Dist(Voice->GetComponentLocation(), Listener);
+					if (Off >= Close && (Ask.bNear || Off > Beyond) && Off > Farthest)
+					{
+						Farthest = Off;
+						Taken = K;
+					}
+				}
+			}
+			if (Taken != INDEX_NONE)
+			{
+				VoicePool[Taken]->FadeOut(CutFade, 0.0f);
+				VoiceTakes[Taken].bFading = true;
+				VoiceTakes[Taken].CutAt = -1.0;
+				++VoicesStolen;
+			}
+			else if (!Ask.bNear)
+			{
+				Out.bHeld = true;
+				return false;
+			}
+		}
+		if (bRoom)
+		{
+			if (Slot == INDEX_NONE)
+			{
+				// (the actor's own, kept by VoicePool, never auto-destroyed; registered with the world as CreateSound2D's are,
+				// and like them attached to nothing)
+				UAudioComponent* const Made = NewObject<UAudioComponent>(this);
+				Made->bAutoActivate = false;
+				Made->bAutoDestroy = false;
+				Made->bIsUISound = false;
+				Made->RegisterComponent();
+				Slot = VoicePool.Add(Made);
+				VoiceTakes.AddDefaulted();
+				++VoicesMade;
+			}
+			else
+			{
+				++VoicesReused;
+			}
+			UAudioComponent* const Voice = VoicePool[Slot];
+			FVoiceTake& Given = VoiceTakes[Slot];
+			++Given.Generation;
+			Given.CutAt = Ask.CutAt;
+			Given.bFar = !Ask.bNear;
+			Given.bFading = false;
+			// (all that CreateSound2D and Lay give a take, given again: a voice keeps whatever its last take left on it. Set
+			// while it is stopped, so SetSound only sets the sound; and only then begun, as Lay begins one, so Play hands the
+			// priority on)
+			Voice->SetSound(Played);
+			Voice->SetVolumeMultiplier(Ask.Volume);
+			Voice->SetPitchMultiplier(1.0f);
+			Voice->bAllowSpatialization = Ask.bPlaced;
+			Voice->AttenuationSettings = Ask.bPlaced ? Family : nullptr;
+			if (Ask.bPlaced)
+			{
+				Voice->SetWorldLocation(Ask.Where);
+			}
+			Voice->bOverridePriority = Ask.Priority > 0.0f;
+			if (Ask.Priority > 0.0f)
+			{
+				Voice->Priority = Ask.Priority;
+			}
+			Voice->Play(Ask.From);
+			++TakesBegun;
+			++TakesPooled;
+			Out.Voice = Voice;
+			Out.Slot = Slot;
+			Out.Generation = Given.Generation;
+			return true;
+		}
+		// (every pooled voice sounding or fading, and as many as the pool may make: a near take is given a voice of its
+		// own, as every take was before the pool, never held)
+		++TakesOwnVoice;
+	}
+	UAudioComponent* const Player = Lay(Played, Ask.bPlaced ? &Ask.Where : nullptr, Family, Ask.Volume, Ask.From, Ask.Priority);
+	if (!Player)
+	{
+		return false;
+	}
+	++TakesBegun;
+	if (Ask.CutAt >= 0.0)
+	{
+		// (the take's part ends by a world timer, as before the pool, counted from the start of the frame it was asked in:
+		// the timer's own clock, which stands there while this frame's actors tick)
+		UWorld* const Here = GetWorld();
+		const double FrameFrom = Here ? Here->GetTimeSeconds() - Here->GetDeltaSeconds() : 0.0;
+		TWeakObjectPtr<UAudioComponent> Weak(Player);
+		FTimerHandle Handle;
+		GetWorldTimerManager().SetTimer(Handle, FTimerDelegate::CreateLambda([Weak]()
+		{
+			if (Weak.IsValid())
+			{
+				Weak->FadeOut(0.08f, 0.0f);
+			}
+		}), static_cast<float>(FMath::Max(0.02, Ask.CutAt - FrameFrom)), false);
+	}
+	Out.Voice = Player;
+	return true;
+}
+
+UAudioComponent* AAirBattle::VoiceOf(const FAirTake& Take) const
+{
+	if (Take.Slot < 0)
+	{
+		return Take.Voice.Get();
+	}
+	return VoiceTakes.IsValidIndex(Take.Slot) && VoiceTakes[Take.Slot].Generation == Take.Generation ? VoicePool[Take.Slot].Get() : nullptr;
+}
+
+void AAirBattle::FadeTake(const FAirTake& Take, float Seconds)
+{
+	if (UAudioComponent* const Voice = VoiceOf(Take))
+	{
+		Voice->FadeOut(Seconds, 0.0f);
+		if (Take.Slot >= 0)
+		{
+			VoiceTakes[Take.Slot].bFading = true;
+			VoiceTakes[Take.Slot].CutAt = -1.0;
+		}
+	}
+}
+
+void AAirBattle::KeepGunTake(int32 Key, const FAirTake& Take)
+{
+	// (its takes still playing kept, the finished ones let go; a pooled voice since given another take is not its)
+	TArray<FAirTake> Had;
+	GunTakes.MultiFind(Key, Had);
+	GunTakes.Remove(Key);
+	for (const FAirTake& One : Had)
+	{
+		UAudioComponent* const Voice = VoiceOf(One);
+		if (Voice && Voice->IsPlaying())
+		{
+			GunTakes.Add(Key, One);
+		}
+	}
+	GunTakes.Add(Key, Take);
+}
+
+void AAirBattle::TakesDue()
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(AirBattle_TakesDue);
+	TakesBegun = 0;
+	if (VoicePool.Num() == 0 && HeldTakes.Num() == 0)
+	{
+		return;
+	}
+	UWorld* const Here = GetWorld();
+	const double Now = Here ? Here->GetTimeSeconds() : 0.0;
+	// Each pooled take's part ends where the mix cuts it (Sound's and SoundAtEye's Cut): faded over 0.08 s, as the world
+	// timer a take was given before the pool, on the same frame (the time a take was asked in counted from its frame's
+	// start, the timer's own clock).
+	for (int32 K = 0; K < VoicePool.Num(); ++K)
+	{
+		FVoiceTake& Take = VoiceTakes[K];
+		if (Take.CutAt >= 0.0 && Now >= Take.CutAt)
+		{
+			Take.CutAt = -1.0;
+			if (UAudioComponent* const Voice = VoicePool[K])
+			{
+				Voice->FadeOut(0.08f, 0.0f);
+				Take.bFading = true;
+			}
+		}
+	}
+	// The takes the cap held, oldest first and before any new take this frame: begun if there is room; else held on,
+	// and dropped only once they have waited longer than HoldFor (air.takesHeldFor), so none begins later than HoldFor
+	// and one frame.
+	if (HeldTakes.Num() > 0)
+	{
+		TArray<FTakeAsk> Waiting = MoveTemp(HeldTakes);
+		HeldTakes.Reset();
+		for (const FTakeAsk& Ask : Waiting)
+		{
+			FAirTake Begun;
+			if (BeginTake(Ask, Begun))
+			{
+				if (Ask.bGun)
+				{
+					++GunTakesLaid;
+				}
+				if (Ask.bStopped)
+				{
+					FadeTake(Begun, 0.08f);
+				}
+				else if (Ask.bGun)
+				{
+					KeepGunTake(Ask.GunKey, Begun);
+				}
+			}
+			else if (Begun.bHeld && Now - Ask.Asked <= HoldFor)
+			{
+				HeldTakes.Add(Ask);
+			}
+			else if (Begun.bHeld)
+			{
+				++TakesDropped;
+			}
+			else if (Ask.bGun)
+			{
+				++GunTakesFar; // (out of earshot by the time there was room)
+			}
+		}
+	}
+}
