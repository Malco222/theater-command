 unreal/TheaterCommand/Content/Data/Sound/mix.json | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/unreal/TheaterCommand/Content/Data/Sound/mix.json b/unreal/TheaterCommand/Content/Data/Sound/mix.json
index 5979f4cc..ce37efee 100644
--- a/unreal/TheaterCommand/Content/Data/Sound/mix.json
+++ b/unreal/TheaterCommand/Content/Data/Sound/mix.json
@@ -1,7 +1,7 @@
 {
   "what": "The battle mix: how every approved battle sound is blended by unit, distance and how hot the fight is, so a battle plays like a war film. Numbers are the sound director's to tune; the 3D game reads them. Spec in plain words: battle-mix.md beside this file.",
   "version": 5,
-  "changes": "v5 (21 Nov, release 2; the 3D game's second air sound patch, sound/air-r2/): rounds striking a plane (air.roundsHit, silent until Brian marks round seven's hits Good); close flak in every view (air.closeView.closeFlak); big moments dip the rest in the air battle (big, air.bigDuck); dead engines thin the drones (air.engineLost); the battle's music driven by the air battle's own meter (music._air). Land (the ground battle sound thread): a new top-level `land` block, which touches no existing row. No number changed. v4's changes: mix-v4.json beside this file. After the review (21 Nov, 19:40Z), no number changed: air.roundsPassing.reach (new, 1000 m: rounds crack past beyond the guns' convergence); a fighter's fixed guns of one kind are one take (air.gunsByCalibre._wing); close flak is always heard (air.closeView.closeFlak._always); formation loops in air.loopsFamily, as written here; the master limiter's knee hard (buses.master._knee). Land block updated 21 Nov 19:25Z by the ground sound thread: land.mgClose.endFade 0.04 replaces tail, tailFade and farTail, and land.cracks.runFade 0.04 replaces runTail (the MG recordings fire on after a burst's last round, so the 0.3 s tail was about eight more rounds at full level). Land block updated 21 Nov 19:36Z by the ground sound thread: land.garand.reloadFromClips and reloadPieces (the reload heard from the clip recordings), and land.smgCue (the squad leader's Thompson burst, MP 38 takes standing in until a real Thompson is recorded). Land block updated 21 Nov 19:39Z by the ground sound thread: land.smgCue.leaderRoles (officer, leader), and the Garand reload and the leader's Thompson switch on by themselves at the first clip cue (notes only; the code default matches). The master limiter's detector (21 Nov 19:50Z): digital, 5 ms look-ahead (buses.master._detector); no number changed. 21 Nov 19:50Z: limits.worldTotal 64 (was 40; limits._worldTotal says why), and the ground sound thread's land block of 19:46Z: land.bodyCues.field_gun_breech null (no recording; the gun's case clangs anyway).",
+  "changes": "v5 (21 Nov, release 2; the 3D game's second air sound patch, sound/air-r2/): rounds striking a plane (air.roundsHit, silent until Brian marks round seven's hits Good); close flak in every view (air.closeView.closeFlak); big moments dip the rest in the air battle (big, air.bigDuck); dead engines thin the drones (air.engineLost); the battle's music driven by the air battle's own meter (music._air). Land (the ground battle sound thread): a new top-level `land` block, which touches no existing row. No number changed. v4's changes: mix-v4.json beside this file. After the review (21 Nov, 19:40Z), no number changed: air.roundsPassing.reach (new, 1000 m: rounds crack past beyond the guns' convergence); a fighter's fixed guns of one kind are one take (air.gunsByCalibre._wing); close flak is always heard (air.closeView.closeFlak._always); formation loops in air.loopsFamily, as written here; the master limiter's knee hard (buses.master._knee). Land block updated 21 Nov 19:25Z by the ground sound thread: land.mgClose.endFade 0.04 replaces tail, tailFade and farTail, and land.cracks.runFade 0.04 replaces runTail (the MG recordings fire on after a burst's last round, so the 0.3 s tail was about eight more rounds at full level). Land block updated 21 Nov 19:36Z by the ground sound thread: land.garand.reloadFromClips and reloadPieces (the reload heard from the clip recordings), and land.smgCue (the squad leader's Thompson burst, MP 38 takes standing in until a real Thompson is recorded). Land block updated 21 Nov 19:39Z by the ground sound thread: land.smgCue.leaderRoles (officer, leader), and the Garand reload and the leader's Thompson switch on by themselves at the first clip cue (notes only; the code default matches). The master limiter's detector (21 Nov 19:50Z): digital, 5 ms look-ahead (buses.master._detector); no number changed. 21 Nov 19:50Z: limits.worldTotal 64 (was 40; limits._worldTotal says why), and the ground sound thread's land block of 19:46Z: land.bodyCues.field_gun_breech null (no recording; the gun's case clangs anyway). Land block updated 21 Nov 20:12Z by the ground sound thread: land.bodyCues.medic_tend null (the medic's cue, silent until a real take passes) and land.armourStrikes (rounds on a tank's armour; its list is empty, so nothing changes until round eight's steel hits pass).",
   "made": "2026-11-21",
   "files": "/mnt/project-files/sound/battle-pack/wav/",
   "units": "metres of the battlefield (the sims' x, y), seconds, decibels. 0 dB = the file as made.",
@@ -883,7 +883,9 @@
       "_how": "A soldier clip's cue and the take it plays; null plays nothing. Also the vehicles' own one-shot cues (hatch, start, brake, squeal, breech): field_gun_breech has no recording yet, and the gun's case already clangs out after its shot (fireModel arm.gun.then), so it is silent.",
       "rifle_drop": null,
       "_rifle_drop": "german_drop_weapon is a German voice calling 'Drop the gun!' (Freesound 443444), for a surrender: a dying man's rifle falling is not a voice. Silent until a real take of a rifle falling is found.",
-      "field_gun_breech": null
+      "field_gun_breech": null,
+      "medic_tend": null,
+      "_medic_tend": "The medic kneeling over a wounded man (the GI clip's 3.5 s 'tend' loop, cue at its start): wants something quiet, cloth, a pouch flap, a low voice. Silent until a real take passes Brian's ear (on the wanted list)."
     },
     "smgCue": {
       "_how": "The squad leader's Thompson (soldier_USA_nco): his fire clip calls `cue` on its first round of a burst of `rounds` (the soldier file: 4 at about 700 a minute). Heard as one take from byNation.smg for his army (the MP 38 takes stand in until a real Thompson is recorded, about 620 a minute), cut at the measured start of round rounds+1 (onsets, seconds into each take) less a fade of half a round's gap, so every round he fires is heard and no more. A take with no more rounds than that plays whole. Once an army's first burst is heard, a rifle round fired by one of leaderRoles of that army plays no rifle take: his fire clip plays for each of his rounds, so its burst carries the sound and it is not heard twice.",
@@ -894,6 +896,13 @@
         "mp40_burst_02": [0.006, 0.104, 0.196, 0.315]
       },
       "leaderRoles": ["officer", "leader"]
+    },
+    "armourStrikes": {
+      "_how": "A rifle or machine-gun round that glances off a tank or other vehicle: a take from smallArms (the ring of the steel it struck) at db, and whineChance of the time a ricochet's whine off it (a piece of groundStrikes.whines, 2 dB under). None listed: the glance plays a ricochet take as before.",
+      "smallArms": [],
+      "_smallArms": "empty until round eight's steel_hit_01..03 (cedarstudios '.45 targetside metal', CC0) pass Brian's ear",
+      "db": -4,
+      "whineChance": 0.3
     }
   }
 }
