@@ -909,7 +909,17 @@
       "helmet_tap": null,
       "_helmet_tap": "the loader slapping the gunner's helmet, the ready signal (7.0 s): silent until a real take passes Brian's ear (on the wanted list).",
       "rifle_shot": null,
-      "_rifle_shot": "A clip's own rifle cue (the loader's carbine): silent, because the round's own shot already plays the rifle; a clip cue would double it."
+      "_rifle_shot": "A clip's own rifle cue (the loader's carbine): silent, because the round's own shot already plays the rifle; a clip cue would double it.",
+      "radio_squelch": null,
+      "_radio_squelch": "The radio man's handset (soldier_USA_radio, radio_call at 1.5 s): an SCR-300's squelch hiss as he keys it. radio.wav in the pack is Morse code, not a voice set's hiss, so it is not used. Silent until a real take passes Brian's ear (on the wanted list).",
+      "radio_talk": null,
+      "_radio_talk": "The radio man calling a fire mission into the handset (radio_call at 1.95 s): a man's voice, muffled through the handset. Silent until a real take passes Brian's ear: an American voice calling a fire mission, not from a film (on the wanted list).",
+      "thompson_mag_out": null,
+      "_thompson_mag_out": "The squad leader's Thompson magazine coming out (reload_stand/kneel/prone at 0.5 s). Silent until a real take of a Thompson's (or a like submachine gun's) magazine change passes Brian's ear (on the wanted list).",
+      "thompson_mag_in": null,
+      "_thompson_mag_in": "The new magazine slapped home (reload at 2.0 s). Silent, as thompson_mag_out.",
+      "thompson_cock": null,
+      "_thompson_cock": "The Thompson's cocking handle pulled back (reload at 2.42 s). Silent, as thompson_mag_out."
     },
     "smgCue": {
       "_how": "The squad leader's Thompson (soldier_USA_nco): his fire clip calls `cue` on its first round of a burst of `rounds` (the soldier file: 4 at about 700 a minute). Heard as one take from byNation.smg for his army (the MP 38 takes stand in until a real Thompson is recorded, about 620 a minute), cut at the measured start of round rounds+1 (onsets, seconds into each take) less a fade of half a round's gap, so every round he fires is heard and no more. A take with no more rounds than that plays whole. Once an army's first burst is heard, a rifle round fired by one of leaderRoles of that army plays no rifle take: his fire clip plays for each of his rounds, so its burst carries the sound and it is not heard twice.",
