diff --git a/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.cpp b/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.cpp
index 7bc83abf..808f9e4f 100644
--- a/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.cpp
+++ b/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.cpp
@@ -1894,4 +1894,255 @@ namespace AirSky
 		Near.Paint(F, Eye, Drift, Sun, Light, NearPoints, NearRgba, nullptr, nullptr, &NearUvs);
 		bBoth = true;
 	}
+
+	Chip::Chip(int InRoom, int InSides)
+		: RoomSlots(std::max(1, InRoom)), SideCount(std::max(6, InSides))
+	{
+		// (each puff's ring turned by its own part of a side, as the painter's TurnCos and TurnSin)
+		for (int K = 0; K < 97; ++K)
+		{
+			const double Golden = K * 0.6180339887;
+			const double A = (Golden - std::floor(Golden)) * 2.0 * Pi / SideCount;
+			TurnCos.push_back(std::cos(A));
+			TurnSin.push_back(std::sin(A));
+		}
+		Cells.assign(static_cast<size_t>(Rows()) * Wide * 4, 0.0f);
+	}
+
+	std::vector<int> Chip::Triangles() const
+	{
+		return Painter(SideCount).Triangles(RoomSlots);
+	}
+
+	void Chip::PointPlaces(std::vector<float>& OutRing, std::vector<float>& OutSlot) const
+	{
+		const size_t Points = static_cast<size_t>(RoomSlots) * PerPuff();
+		OutRing.assign(Points * 2, 0.0f);
+		OutSlot.assign(Points * 2, 0.0f);
+		for (int Slot = 0; Slot < RoomSlots; ++Slot)
+		{
+			const float Column = static_cast<float>((Slot % PuffsPerRow) * TexelsPerPuff), Row = static_cast<float>(1 + Slot / PuffsPerRow);
+			for (int P = 0; P < PerPuff(); ++P)
+			{
+				const size_t At = (static_cast<size_t>(Slot) * PerPuff() + P) * 2;
+				// (the middle 0; the heart ring's points 1 to Sides, the rim's after them, as Painter::Triangles lays them)
+				const int Ring = P == 0 ? 0 : P <= SideCount ? 1 : 2;
+				const int K = Ring == 0 ? 0 : Ring == 1 ? P - 1 : P - 1 - SideCount;
+				OutRing[At] = static_cast<float>(K);
+				OutRing[At + 1] = static_cast<float>(Ring);
+				OutSlot[At] = Column;
+				OutSlot[At + 1] = Row;
+			}
+		}
+	}
+
+	void Chip::SetOrderTurn(double InTurn)
+	{
+		Turn = std::isfinite(InTurn) ? Clamp(InTurn, 0.002, 0.2) : DefaultOrderTurn;
+	}
+
+	int Chip::SlotPuff(int Slot) const
+	{
+		return Slot >= 0 && Slot < LastLaid ? Order[static_cast<size_t>(LastDropped + Slot)].Puff : -1;
+	}
+
+	int Chip::SlotCloud(int Slot) const
+	{
+		return Slot >= 0 && Slot < LastLaid ? Order[static_cast<size_t>(LastDropped + Slot)].Cloud : -1;
+	}
+
+	bool Chip::Wants(const Vec& Eye, const Vec& Drift) const
+	{
+		if (!bLaid)
+		{
+			return true;
+		}
+		const double Carried = (Drift - LastDrift).Length();
+		if ((bEasing && Carried > 3.0) || (bClearing && Carried > 15.0))
+		{
+			return true;
+		}
+		return ((Eye - Drift) - LastEye).Length() > LastSlack;
+	}
+
+	void Chip::Lay(const Field& F, const Vec& Eye, const Vec& Drift, const Vec& Sun, const Rgb& Light)
+	{
+		// Painter::Paint's gathering, for the sheet's shapes and the whole sky (one painter, all of it), without its
+		// points: which clouds, where (the copy nearest the eye, lifted, squashed, thinned by the clearing), and which of
+		// their puffs, far to near; each out past the reach and its level's fade by the Margin, so that the chip, which
+		// fades them itself, has every puff it could draw before the next lay.
+		const Vec Seen = Eye - Drift;
+		const size_t CloudCount = F.Clouds.size();
+		if (Serial != F.Serial || Lifts.size() != CloudCount)
+		{
+			Lifts.assign(CloudCount, Kept());
+			Serial = F.Serial;
+		}
+		Where.assign(CloudCount, Placed());
+		Order.clear();
+		bEasing = false;
+		bClearing = false;
+		const Vec Carry = F.DriftAt(1.0);
+		const Vec Lead = Carry.Length() > 1e-9 ? Carry * (250.0 / Carry.Length()) : Vec();
+		const Vec SunWay = Sun.Unit(Vec(-0.35, -0.45, 0.82));
+		double Near = 1e18;
+		int Drawn = 0;
+		for (size_t I = 0; I < CloudCount; ++I)
+		{
+			const Cloud& C = F.Clouds[I];
+			const int Index = static_cast<int>(I);
+			const Vec Shift = F.ShiftNear(Index, Seen.X, Seen.Y);
+			const double LX = C.At.X + Shift.X, LY = C.At.Y + Shift.Y;
+			if (std::hypot(LX - Seen.X, LY - Seen.Y) > Reach + C.W + Margin)
+			{
+				continue;
+			}
+			// (its lift eased as the painter eases it)
+			const double WX = LX + Drift.X, WY = LY + Drift.Y;
+			Kept& Lift = Lifts[I];
+			const double Jump = std::hypot(WX - Lift.PX, WY - Lift.PY);
+			bool bStillEasing = false;
+			auto LiftHere = [&F, Index, &Lead](double X, double Y)
+			{
+				const double Now = F.LiftAt(Index, X, Y);
+				return Lead.X == 0.0 && Lead.Y == 0.0 ? Now : std::max(Now, F.LiftAt(Index, X + Lead.X, Y + Lead.Y));
+			};
+			if (Lift.Shown < 0.0 || Jump > 1000.0)
+			{
+				Lift.X = WX;
+				Lift.Y = WY;
+				Lift.Target = LiftHere(WX, WY);
+				Lift.Shown = Lift.Target;
+			}
+			else
+			{
+				if ((WX - Lift.X) * (WX - Lift.X) + (WY - Lift.Y) * (WY - Lift.Y) > 30.0 * 30.0)
+				{
+					Lift.X = WX;
+					Lift.Y = WY;
+					Lift.Target = LiftHere(WX, WY);
+				}
+				Lift.Shown += Clamp(Lift.Target - Lift.Shown, -0.75 * Jump, 1.5 * Jump);
+				bStillEasing = std::fabs(Lift.Target - Lift.Shown) > 0.5;
+			}
+			Lift.PX = WX;
+			Lift.PY = WY;
+			// (a cumulus whose near edge comes within 4 km of the target, where the clearing thins what the wind carries in
+			// (Field::ShownAt): its share shown moves with the wind's carry, so the table is laid again as it does)
+			if (!F.Sky.bDeck && std::hypot(WX - F.TargetX, WY - F.TargetY) - 0.45 * C.W < 4200.0)
+			{
+				bClearing = true;
+			}
+			Placed& Here = Where[I];
+			Here = F.PlaceLifted(Index, Shift, Drift, Lift.Shown);
+			if (Here.Show < 0.002)
+			{
+				continue;
+			}
+			const Vec Middle(LX, LY, C.At.Z + Here.Lift + 0.5 * Here.Squash * C.H);
+			const double Far = (Middle - Seen).Length();
+			if (Smooth((Reach - (Far - Margin)) / (Reach / 3.0)) <= 0.0)
+			{
+				continue;
+			}
+			bEasing = bEasing || bStillEasing;
+			const double Haze = Smooth((Reach - Far) / (Reach / 3.0));
+			const double NearShare = Smooth((NearAll + 1000.0 - Far) / 1000.0), FarShare = Smooth((FarAll + 1500.0 - Far) / 1500.0);
+			const bool bHeap = C.Count > 1 && F.Puffs[static_cast<size_t>(C.First)].bFlatFoot;
+			for (int K = C.First; K < C.First + C.Count; ++K)
+			{
+				const Puff& Each = F.Puffs[static_cast<size_t>(K)];
+				if ((bHeap && Each.Lod == 2) || Here.Show * Each.Alpha < 0.002)
+				{
+					continue;
+				}
+				// (each level's share is nought only past its own distance: kept if the eye, within the Margin, could
+				// bring it in)
+				const bool bFirst = bHeap && K == C.First;
+				const bool bMay = bFirst || Each.Lod == 0 ? Far - Margin < NearAll + 1000.0 : Each.Lod == 1 ? Far - Margin < FarAll + 1500.0 : Each.Lod == 3 ? Far + Margin > NearAll : true;
+				if (!bMay)
+				{
+					continue;
+				}
+				const Vec At(Each.At.X + Shift.X, Each.At.Y + Shift.Y, C.At.Z + Here.Lift + (Each.At.Z - C.At.Z) * Here.Squash);
+				const Vec D = At - Seen;
+				Order.push_back({ K, Index, D.Dot(D) });
+				// (drawn from here, as the painter would: its nearest, for the order's slack)
+				const double Share = bFirst ? NearShare : Each.Lod == 3 ? 1.0 - NearShare : Each.Lod == 2 ? 1.0 : Each.Lod == 1 ? FarShare : NearShare;
+				if (Haze > 0.0 && Haze * Share * Here.Show * Each.Alpha >= 0.002)
+				{
+					const Vec Mid = bFirst ? Vec(LX, LY, At.Z) : At;
+					Near = std::min(Near, (Mid - Seen).Length() - Each.R);
+					++Drawn;
+				}
+			}
+		}
+		// (far to near, as see-through things are drawn; with no room for them all, the farthest go)
+		auto Farther = [](const Slotted& A, const Slotted& B) { return A.Deep > B.Deep; };
+		const int Count = static_cast<int>(Order.size());
+		LastDropped = std::max(0, Count - RoomSlots);
+		LastLaid = Count - LastDropped;
+		if (LastDropped > 0)
+		{
+			std::nth_element(Order.begin(), Order.begin() + LastDropped, Order.end(), Farther);
+		}
+		std::sort(Order.begin() + LastDropped, Order.end(), Farther);
+		LastDrawn = Drawn;
+
+		// The header: the sun's way and a sheet cell's half width; the paints as the painter's Tone gives them (the
+		// shaded side and the base under the ink's share, by the hour's light); the floor's share, the sprite's span, the
+		// reach, the levels' distances, the puffs laid and a puff's sides.
+		auto Put = [this](int Row, int Texel, double A, double B, double C, double D)
+		{
+			float* At = &Cells[(static_cast<size_t>(Row) * Wide + static_cast<size_t>(Texel)) * 4];
+			At[0] = static_cast<float>(A);
+			At[1] = static_cast<float>(B);
+			At[2] = static_cast<float>(C);
+			At[3] = static_cast<float>(D);
+		};
+		const Rgb BaseInked = BaseSide * (1.0 / Ink), ShadeInked = ShadeSide * (1.0 / Ink);
+		Put(0, 0, SunWay.X, SunWay.Y, SunWay.Z, 0.49 / FragmentCells);
+		Put(0, 1, BaseInked.R * Light.R, BaseInked.G * Light.G, BaseInked.B * Light.B, FragmentFloor / 0.98);
+		Put(0, 2, ShadeInked.R * Light.R, ShadeInked.G * Light.G, ShadeInked.B * Light.B, Painter::SpriteSpan);
+		Put(0, 3, SunSide.R * Light.R, SunSide.G * Light.G, SunSide.B * Light.B, Reach);
+		Put(0, 4, NearAll, FarAll, LastLaid, SideCount);
+
+		// Each puff: eight texels (AirSkyChip.inl).
+		const int SheetCells = FragmentCells * FragmentCells, Tops = SheetCells - FragmentBases - FragmentFeet;
+		auto SheetU = [](int Pick) { return (Pick % FragmentCells + 0.5) / FragmentCells; };
+		auto SheetV = [](int Pick) { return (Pick / FragmentCells + 0.5) / FragmentCells; };
+		for (int Slot = 0; Slot < LastLaid; ++Slot)
+		{
+			const Slotted& O = Order[static_cast<size_t>(LastDropped + Slot)];
+			const Puff& Each = F.Puffs[static_cast<size_t>(O.Puff)];
+			const Cloud& Cl = F.Clouds[static_cast<size_t>(O.Cloud)];
+			const Placed& Here = Where[static_cast<size_t>(O.Cloud)];
+			const bool bHeapHere = Cl.Count > 1 && F.Puffs[static_cast<size_t>(Cl.First)].bFlatFoot;
+			const bool bFoot = bHeapHere && O.Puff == Cl.First;
+			const bool bFlatFoot = Each.bFlatFoot && (!bHeapHere || bFoot);
+			const bool bLowLump = bHeapHere && Each.bFlatFoot && !bFoot;
+			const double CloudX = Cl.At.X + Here.Shift.X, CloudY = Cl.At.Y + Here.Shift.Y;
+			const double PX = bFoot ? CloudX : Each.At.X + Here.Shift.X, PY = bFoot ? CloudY : Each.At.Y + Here.Shift.Y;
+			const double PZ = Cl.At.Z + Here.Lift + (Each.At.Z - Cl.At.Z) * Here.Squash;
+			const int Row = 1 + Slot / PuffsPerRow, First = (Slot % PuffsPerRow) * TexelsPerPuff;
+			const size_t Phase = static_cast<size_t>(O.Puff % 97);
+			const int FootPick = Tops + FragmentBases + O.Cloud % FragmentFeet;
+			const int UpPick = bFoot ? FootPick : Tops + O.Puff % FragmentBases, TopPick = bFoot ? FootPick : O.Puff % Tops;
+			const int Flags = (bFlatFoot ? 1 : 0) | (bFoot ? 2 : 0) | (bLowLump ? 4 : 0) | (bHeapHere ? 8 : 0);
+			Put(Row, First + 0, PX, PY, PZ, Each.R);
+			Put(Row, First + 1, CloudX, CloudY, Cl.At.Z + Here.Lift, Here.Squash * Cl.H);
+			Put(Row, First + 2, Cl.W, 0.5 * Cl.W * (F.Sky.bDeck && !Cl.bScrap ? 1.25 : 1.0), Here.Squash, Each.Flat);
+			Put(Row, First + 3, Here.Show * Each.Alpha, Each.Lit, Each.Trough, Each.Shadowed);
+			Put(Row, First + 4, TurnCos[Phase], TurnSin[Phase], PhaseSines(false)[Phase], (O.Puff / SheetCells) % 2 == 1 ? -1.0 : 1.0);
+			Put(Row, First + 5, SheetU(TopPick), SheetV(TopPick), SheetU(UpPick), SheetV(UpPick));
+			Put(Row, First + 6, 1.0, 1.0, 0.0, 1.0);
+			Put(Row, First + 7, Each.Lod, Flags, 0.0, bFoot ? 0.4 * Cl.W : 0.0);
+		}
+		bLaid = true;
+		++LayCount;
+		LastEye = Seen;
+		LastDrift = Drift;
+		LastNear = Drawn > 0 ? std::max(50.0, Near) : 50.0;
+		LastSlack = Clamp(Turn * LastNear, 2.0, Margin);
+	}
 }
diff --git a/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.h b/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.h
index 1bc16e03..3f8fdf5f 100644
--- a/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.h
+++ b/unreal/TheaterCommand/Source/TheaterCommand/Battle/AirSky.h
@@ -461,4 +461,110 @@ namespace AirSky
 	 * there, and some 23 at the heart ring (0.27 was only some 13 per cent). */
 	constexpr double ShadowDark = 0.5;
 	constexpr double ShadowReach = 10000.0;
+
+	/**
+	 * The clouds turned to the eye on the graphics chip (the speed gate's GS6; the graphics audit's item 10). The rooms
+	 * turn every puff to the eye here, on the game's thread, and send all their points to the engine again each time
+	 * the eye moves enough for a turn to show: on the Mac in the ground battle 1.98 ms a turn cool and 5.40 hot, 22 to 64
+	 * turns in 30 s, the near room's 800 puffs (26,400 points) sent each time and the far room's 3,200 on a far turn.
+	 *
+	 * Here the mesh is made once (Triangles, PointPlaces: a slot's 33 points, all at the mesh's own middle) and every
+	 * point is placed, turned, lit and faded where the engine places points (M_CloudTurned, the vertex shader), every
+	 * frame, for the eye as it is then, by AirSkyChip.inl: Painter::Paint's own arithmetic for a puff drawn from the
+	 * sheet's shapes, which the cloud test runs in C++ against the painter's own points. What it reads is a table of
+	 * the puffs round the eye, far to near (Lay, Table): the order the see-through puffs are drawn in is the one thing
+	 * the chip cannot work out for itself, so the table is laid again (and sent: about half a megabyte, no mesh) only
+	 * when the eye has moved far enough for that order to go stale (Wants), a share of the nearest puff's distance
+	 * (SetOrderTurn), and as the wind carries the clouds only while a drawn cloud's lift eases over high ground or a
+	 * cloud stands within the target's clearing.
+	 *
+	 * The table holds every puff that could be drawn while the eye stays within Margin of where it was laid (out past
+	 * the reach and each level's fade by that much), so that a puff the chip fades in between two lays is there.
+	 */
+	class Chip
+	{
+	public:
+		/** Texels (four floats each) a puff, puffs a row, the table's width, and the header's texels in row 0. */
+		static constexpr int TexelsPerPuff = 8;
+		static constexpr int PuffsPerRow = 256;
+		static constexpr int Wide = TexelsPerPuff * PuffsPerRow;
+		static constexpr int HeaderTexels = 5;
+		/** How far the eye may move from where the table was laid before it is laid again whatever else (metres): every
+		 * puff that could be drawn that far off is in the table. */
+		static constexpr double Margin = 400.0;
+		/** The order's staleness: by default the eye may move 2.5 per cent of the nearest drawn puff's distance (the near
+		 * room turned at 0.45 per cent, for the puffs' turn, which the chip makes every frame). */
+		static constexpr double DefaultOrderTurn = 0.025;
+
+		/** InRoom: the puffs the mesh is made with (its slots); a puff a slot. */
+		explicit Chip(int InRoom = 6000, int InSides = 16);
+		int Room() const { return RoomSlots; }
+		int Sides() const { return SideCount; }
+		int PerPuff() const { return 1 + 2 * SideCount; }
+		/** The table's rows: the header's and enough for every slot. */
+		int Rows() const { return 1 + (RoomSlots + PuffsPerRow - 1) / PuffsPerRow; }
+		/** The mesh's triangles: the painter's own for each slot (a middle, a heart ring and a rim ring, both faces). */
+		std::vector<int> Triangles() const;
+		/** Each point's two texture coordinates, two numbers each, a slot's points in a row: its place round its puff
+		 * (OutRing: the point round the ring, 0 to Sides - 1, and which ring, 0 the middle, 1 the heart, 2 the rim) and its
+		 * slot's first texel in the table (OutSlot: column, row). Whole numbers under 2,048, which the engine's half floats
+		 * hold exactly. */
+		void PointPlaces(std::vector<float>& OutRing, std::vector<float>& OutSlot) const;
+		/** The scene's cloud ink, as Painter::SetInk. */
+		void SetInk(double InInk) { Ink = InInk > 0.1 ? InInk : 1.0; }
+		/** The order's staleness, a share of the nearest drawn puff's distance (from 0.002 to 0.2). */
+		void SetOrderTurn(double InTurn);
+		double OrderTurn() const { return Turn; }
+		/** Whether the table wants laying again for this eye (Painter::Paint's terms): never laid, the eye moved past the
+		 * order's slack in the field's own frame, or the wind's carry while a lift eases (3 m) or a cloud stands in the
+		 * clearing (15 m). A few sums: the scene asks it every frame. */
+		bool Wants(const Vec& Eye, const Vec& Drift) const;
+		/** Lays the table for an eye (Painter::Paint's terms; the paints in the header are the painter's Tone for Light
+		 * and the ink). */
+		void Lay(const Field& F, const Vec& Eye, const Vec& Drift, const Vec& Sun, const Rgb& Light);
+		/** Rows by Wide texels, four floats each, row 0 the header (AirSkyChip.inl gives what each holds). */
+		const std::vector<float>& Table() const { return Cells; }
+		/** The rows the last lay wrote (the header's and the puffs'): the rows to send. Past them, slots the shader
+		 * leaves out by the header's count. */
+		int RowsUsed() const { return 1 + (LastLaid + PuffsPerRow - 1) / PuffsPerRow; }
+		/** The puffs in the table, those it had no room for (the farthest), and those drawn from where it was laid. */
+		int Laid() const { return LastLaid; }
+		int Dropped() const { return LastDropped; }
+		int DrawnThen() const { return LastDrawn; }
+		/** The nearest drawn puff's distance less its radius when laid, and the eye's slack from there (metres). */
+		double Nearest() const { return LastNear; }
+		double Slack() const { return LastSlack; }
+		/** Which of the field's puffs a slot holds (-1 an empty slot), and which cloud. */
+		int SlotPuff(int Slot) const;
+		int SlotCloud(int Slot) const;
+		/** How many times the table has been laid. */
+		int Lays() const { return LayCount; }
+
+	private:
+		int RoomSlots = 6000;
+		int SideCount = 16;
+		double Ink = 1.0;
+		double Turn = DefaultOrderTurn;
+		std::vector<float> Cells;
+		std::vector<double> TurnCos, TurnSin;
+		struct Slotted
+		{
+			int Puff = 0, Cloud = 0;
+			double Deep = 0.0;
+		};
+		std::vector<Slotted> Order;
+		std::vector<Placed> Where;
+		// (each cloud's lift, eased as the painter's: the ground looked up again once its middle has moved 30 m, the lift
+		// drawn eased toward it as the cloud drifts)
+		struct Kept
+		{
+			double X = 1e30, Y = 1e30, PX = 1e30, PY = 1e30, Target = 0.0, Shown = -1.0;
+		};
+		std::vector<Kept> Lifts;
+		uint64_t Serial = 0;
+		bool bLaid = false, bEasing = false, bClearing = false;
+		Vec LastEye, LastDrift;
+		double LastNear = 1000.0, LastSlack = 1.0;
+		int LastLaid = 0, LastDropped = 0, LastDrawn = 0, LayCount = 0;
+	};
 }
diff --git a/unreal/TheaterCommand/Tools/air_show/air_sky_chip.h b/unreal/TheaterCommand/Tools/air_show/air_sky_chip.h
new file mode 100644
index 00000000..356c6f4d
--- /dev/null
+++ b/unreal/TheaterCommand/Tools/air_show/air_sky_chip.h
@@ -0,0 +1,46 @@
+#pragma once
+
+// The clouds' chip arithmetic (Source/TheaterCommand/Battle/AirSkyChip.inl) in C++, for the cloud test: the same text
+// M_CloudTurned runs on the graphics chip, given the few HLSL types and functions it uses. Nothing else is added here,
+// so that what the test checks is what the chip runs.
+
+#include <algorithm>
+#include <cmath>
+
+namespace AirSkyChipCpp
+{
+	struct float3
+	{
+		float x = 0.0f, y = 0.0f, z = 0.0f;
+		float3() = default;
+		float3(float X, float Y, float Z) : x(X), y(Y), z(Z) {}
+	};
+
+	struct float4
+	{
+		float x = 0.0f, y = 0.0f, z = 0.0f, w = 0.0f;
+		float4() = default;
+		float4(float X, float Y, float Z, float W) : x(X), y(Y), z(Z), w(W) {}
+	};
+
+	inline float3 operator+(const float3& A, const float3& B) { return float3(A.x + B.x, A.y + B.y, A.z + B.z); }
+	inline float3 operator-(const float3& A, const float3& B) { return float3(A.x - B.x, A.y - B.y, A.z - B.z); }
+	inline float3 operator*(const float3& A, float S) { return float3(A.x * S, A.y * S, A.z * S); }
+	inline float3 operator*(float S, const float3& A) { return float3(A.x * S, A.y * S, A.z * S); }
+	inline float3 operator/(const float3& A, float S) { return float3(A.x / S, A.y / S, A.z / S); }
+	inline float3 operator-(const float3& A) { return float3(-A.x, -A.y, -A.z); }
+	inline float dot(const float3& A, const float3& B) { return A.x * B.x + A.y * B.y + A.z * B.z; }
+	inline float3 cross(const float3& A, const float3& B) { return float3(A.y * B.z - A.z * B.y, A.z * B.x - A.x * B.z, A.x * B.y - A.y * B.x); }
+	inline float sqrt(float V) { return std::sqrt(V); }
+	inline float length(const float3& A) { return std::sqrt(dot(A, A)); }
+	inline float3 normalize(const float3& A) { return A / length(A); }
+	inline float max(float A, float B) { return A > B ? A : B; }
+	inline float min(float A, float B) { return A < B ? A : B; }
+	inline float clamp(float V, float A, float B) { return min(max(V, A), B); }
+	inline float cos(float V) { return std::cos(V); }
+	inline float sin(float V) { return std::sin(V); }
+	inline float atan2(float Y, float X) { return std::atan2(Y, X); }
+	inline float floor(float V) { return std::floor(V); }
+
+#include "Battle/AirSkyChip.inl"
+}
